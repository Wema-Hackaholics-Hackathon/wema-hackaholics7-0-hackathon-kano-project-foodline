# Copy to .env (for `next dev`) and .dev.vars (for `npm run preview`).
# Production values are set as Worker secrets: `npx wrangler secret put <NAME>`.

# Mono (https://app.mono.co) - test keys
MONO_PUBLIC_KEY=test_pk_xxx
MONO_SECRET_KEY=test_sk_xxx
# Shared secret you configure on the Mono dashboard webhook settings
MONO_WEBHOOK_SECRET=choose-a-long-random-string
# Same as MONO_PUBLIC_KEY - exposed to the browser for the Connect widget
NEXT_PUBLIC_MONO_PUBLIC_KEY=test_pk_xxx

# Paystack (https://dashboard.paystack.com) - test keys
PAYSTACK_PUBLIC_KEY=pk_test_xxx
PAYSTACK_SECRET_KEY=sk_test_xxx

# Session cookie signing/encryption secret (generate: openssl rand -hex 32)
SESSION_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Only needed for deploying (wrangler). Not used by the app at runtime.
CLOUDFLARE_API_TOKEN=
